# --- Database Configuration ---
# Used by Docker Compose to initialize the PostgreSQL container
DB_PASSWORD=your_secure_password_here

# Used by FastAPI/SQLAlchemy to connect to the database via Docker network
DATABASE_URL=postgresql://admin:your_secure_password_here@db:5432/ticket_db

# --- Connection Pool Configuration ---
# Tune these based on your PostgreSQL max_connections setting.
# Defaults are 5 and 10 to protect free-tier deployments.
POOL_SIZE=5
MAX_OVERFLOW=10

# --- JWT Security ---
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Rate Limiting ---
# Defaults to 5/minute in production for brute-force protection.
# Tests override this via conftest.py; do not lower this for real deployments.
LOGIN_RATE_LIMIT=5/minute

# --- Background Worker ---
# Simulated delay (seconds) for the ticket-generation background task demo.
# Tests override this to 0 via conftest.py for speed.
SIMULATED_DELAY_SECONDS=5

# --- Frontend Integration ---
FRONTEND_URL=http://localhost:5173

# --- Database Seeding ---
# Used only by seed.py when creating the initial 'superadmin' account.
# ALWAYS set this to a real, non-default value before running seed.py
# anywhere other than a fully local, disposable dev database.
DEMO_ADMIN_PASSWORD=change_this_before_seeding

# --- Testing ---
# Used only by conftest.py — a separate logical database from ticket_db,
# so pytest never touches your real development data.
TEST_DATABASE_URL=postgresql://admin:your_secure_password_here@db:5432/ticket_db_test

# --- Manual Stress Testing ---
# Used only by stress_test.py — paste a real JWT here when running it manually.
# Get one by logging in via Swagger UI (/docs) and copying the access_token.
TEST_ACCESS_TOKEN=PASTE_YOUR_ACCESS_TOKEN_HERE